# Source: {target} has an adjust variant for use on someone. {source} has none. Targeting someone keeps {target}'s animation.
advice.adjust = {target} a une variante ajustée pour une utilisation sur \nquelqu'un. {source} n'en a pas. Cibler quelqu'un \nconserve l'animation de {target}.
# Source: {target} is the emote being bypassed.
advice.being_bypassed = {target} est l'emote bypassée.
# Source: {target} is on your blocked targets list. This override uses it anyway.
advice.blocked = {target} est dans votre liste de cibles bloquées. Ce remplacement l'utilise quand même.
# Source: {target} has an intro and {source} does not.
advice.intro_added = {target} a une introduction et {source} n'en a pas.
# Source: {target} has no intro and {source} has one. The intro will not play.
advice.intro_dropped = {target} n'a pas d'introduction et {source} en a une. L'introduction ne sera pas jouée.
# Source: {target} loops while {source} plays once. Weird behavior might happen.
advice.loops = {target} boucle alors que {source} se joue une fois. Un comportement étrange peut se produire.
# Source: {target} has no {posture} animation. The swap will not happen when you play {source} in that posture.
advice.missing_posture = {target} n'a pas d'animation {posture}. Le swap n'aura pas lieu quand vous jouez {source} dans cette posture.
# Source: Your mod "{mod}" already changes {target}. Your "Emotes your mods change" setting still applies.
advice.mod_changes = Votre mod "{mod}" modifie déjà {target}. Votre réglage "Emotes modifiées par vos mods" s'applique toujours.
# Source: {target} can never be a swap target (pose, facial expression, per-job emote or weapon drawn). It is always skipped.
advice.never_target = {target} ne peut jamais être une cible de swap (pose, expression faciale, emote de job ou arme dégainée). Elle est toujours ignorée.
# Source: You have not unlocked {target}. It is skipped.
advice.not_unlocked = Vous n'avez pas débloqué {target}. Elle est ignorée.
# Source: {target} and {source} share no posture. The swap will not happen.
advice.no_posture = {target} et {source} ne partagent aucune posture. Le swap n'aura pas lieu.
# Source: {target} plays once while {source} loops. The animation will stop instead of looping.
advice.plays_once = {target} se joue une fois alors que {source} boucle. L'animation s'arrêtera au lieu de boucler.
# Source: chair sitting
advice.posture.chair_sitting = assis sur une chaise
# Source: ground sitting
advice.posture.ground_sitting = assis par terre
# Source: matching
advice.posture.matching = correspondante
# Source: mounted
advice.posture.mounted = sur monture
# Source: {first} or {second}
advice.posture.or = {first} ou {second}
# Source: standing
advice.posture.standing = debout
# Source: {target} emits a sound that {source} does not. Everyone around you will hear it.
advice.sound = {target} émet un son que {source} n'émet pas. Tout le monde autour de vous l'entendra.
# Source: {target} will stop when you turn your character.
advice.stops_on_turn = {target} s'arrêtera quand vous tournerez votre personnage.
# Source: When you target someone, {target} {target_turn} while {source} {source_turn}.
advice.turn = Quand vous ciblez quelqu'un, {target} {target_turn} alors que {source} {source_turn}.
# Source: turns the whole body
advice.turn.body = tourne tout le corps
# Source: only follows with the eyes
advice.turn.eyes = suit seulement du regard
# Source: turns the head
advice.turn.head = tourne la tête
# Source: does not turn at all
advice.turn.none = ne tourne pas du tout
# Source: turns in a way the plugin could not read
advice.turn.unknown = tourne d'une façon que le plugin n'a pas pu lire
# Source: {target} emits a voice line sound. Everyone around you will hear it.
advice.voice_line = {target} émet une réplique vocale. Tout le monde autour de vous l'entendra.
