# Source: {target} has an adjust variant for use on someone. {source} has none. Targeting someone keeps {target}'s animation.
advice.adjust = {target} hat eine Variante für die Verwendung an jemandem. {source} hat keine. Wenn du jemanden anvisierst, bleibt die Animation von {target}.
# Source: {target} is the emote being bypassed.
advice.being_bypassed = {target} ist das Emote, das umgangen wird.
# Source: {target} is on your blocked targets list. This override uses it anyway.
advice.blocked = {target} steht auf deiner Liste gesperrter Ziele. Diese Zuweisung verwendet es trotzdem.
# Source: {target} has an intro and {source} does not.
advice.intro_added = {target} hat ein Intro, {source} nicht.
# Source: {target} has no intro and {source} has one. The intro will not play.
advice.intro_dropped = {target} hat kein Intro, {source} schon. Das Intro wird nicht abgespielt.
# Source: {target} loops while {source} plays once. Weird behavior might happen.
advice.loops = {target} läuft in Schleife, während {source} einmal abgespielt wird. Es kann zu seltsamem Verhalten kommen.
# Source: {target} has no {posture} animation. The swap will not happen when you play {source} in that posture.
advice.missing_posture = {target} hat keine Animation im Zustand „{posture}“. Der Tausch findet nicht statt, wenn du {source} in dieser Haltung abspielst.
# Source: Your mod "{mod}" already changes {target}. Your "Emotes your mods change" setting still applies.
advice.mod_changes = Deine Mod „{mod}“ verändert {target} bereits. Deine Einstellung „Von deinen Mods veränderte Emotes“ gilt weiterhin.
# Source: {target} can never be a swap target (pose, facial expression, per-job emote or weapon drawn). It is always skipped.
advice.never_target = {target} kann nie ein Tauschziel sein (Haltung, Gesichtsausdruck, klassenspezifisches Emote oder gezogene Waffe). Es wird immer übersprungen.
# Source: You have not unlocked {target}. It is skipped.
advice.not_unlocked = Du hast {target} nicht freigeschaltet. Es wird übersprungen.
# Source: {target} and {source} share no posture. The swap will not happen.
advice.no_posture = {target} und {source} haben keine gemeinsame Haltung. Der Tausch findet nicht statt.
# Source: {target} plays once while {source} loops. The animation will stop instead of looping.
advice.plays_once = {target} wird einmal abgespielt, während {source} in Schleife läuft. Die Animation endet, statt sich zu wiederholen.
# Source: chair sitting
advice.posture.chair_sitting = auf einem Stuhl sitzend
# Source: ground sitting
advice.posture.ground_sitting = auf dem Boden sitzend
# Source: matching
advice.posture.matching = passend
# Source: mounted
advice.posture.mounted = beritten
# Source: {first} or {second}
advice.posture.or = {first} oder {second}
# Source: standing
advice.posture.standing = stehend
# Source: {target} emits a sound that {source} does not. Everyone around you will hear it.
advice.sound = {target} gibt einen Ton aus, den {source} nicht hat. Alle um dich herum hören ihn.
# Source: {target} will stop when you turn your character.
advice.stops_on_turn = {target} endet, wenn du deinen Charakter drehst.
# Source: When you target someone, {target} {target_turn} while {source} {source_turn}.
advice.turn = Wenn du jemanden anvisierst: {target} {target_turn}, {source} dagegen {source_turn}.
# Source: turns the whole body
advice.turn.body = dreht den ganzen Körper
# Source: only follows with the eyes
advice.turn.eyes = folgt nur mit den Augen
# Source: turns the head
advice.turn.head = dreht den Kopf
# Source: does not turn at all
advice.turn.none = dreht sich überhaupt nicht
# Source: turns in a way the plugin could not read
advice.turn.unknown = dreht sich auf eine Weise, die das Plugin nicht lesen konnte
# Source: {target} emits a voice line sound. Everyone around you will hear it.
advice.voice_line = {target} gibt eine Sprachausgabe aus. Alle um dich herum hören sie.
